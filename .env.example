# Application
NODE_ENV=development
PORT=3000


# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=costflow
POSTGRES_USER=costflow
POSTGRES_PASSWORD=costflow

DATABASE_URL=postgresql://costflow:costflow@localhost:5432/costflow
DATABASE_POOL_SIZE=5


# Valkey
VALKEY_HOST=localhost
VALKEY_PORT=6379


# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

LOCALSTACK_HOST=localhost
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0

AWS_ENDPOINT=http://localhost:4566


# S3
INVOICE_BUCKET=costflow-invoices-local


# SQS
INVOICE_PROCESSING_QUEUE=costflow-invoice-processing
INVOICE_PROCESSING_DLQ=costflow-invoice-processing-dlq